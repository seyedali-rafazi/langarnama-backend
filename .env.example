# ==========================================
# Langarnama Vessel Tracking API Configuration
# ==========================================

HOST=0.0.0.0
PORT=8000
DEBUG=true

# AISStream.io API Configuration (https://aisstream.io)
AISSTREAM_API_KEY=your_aisstream_api_key_here
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_RECONNECT_DELAY_SECONDS=5.0
AISSTREAM_CONNECT_TIMEOUT_SECONDS=15.0

# Bounding Box Filter for AISStream (latitude/longitude pairs)
AISSTREAM_BBOX=[[[22.0, 47.0], [40.0, 64.0]]]
AISSTREAM_MESSAGE_TYPES=["PositionReport","StandardClassBPositionReport","ShipStaticData","ExtendedClassBPositionReport"]

# In-Memory Cache & Track Settings
SHIP_INACTIVE_TIMEOUT_SECONDS=3600
MAX_TRACK_POINTS_PER_SHIP=100
FALLBACK_SAMPLE_DATA=true

# Default Viewport Coordinates (Middle East / Persian Gulf Waters)
DEFAULT_LAMIN=22.0
DEFAULT_LOMIN=47.0
DEFAULT_LAMAX=40.0
DEFAULT_LOMAX=64.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","https://www.langarnama.ir"]